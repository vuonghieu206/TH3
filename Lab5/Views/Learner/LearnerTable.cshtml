@model IEnumerable<Learner>
<table class="table table-striped table-hover align-middle">
    <thead class="table-light">
        <tr>
            <th>Mã</th>
            <th>Tên</th>
            <th>Họ</th>
            <th>Ngành</th>
            <th>Ngày nhập học</th>
            <th>Chức năng</th>
        </tr>
    </thead>
    <tbody>
    @if (!Model.Any())
    {
        <tr><td colspan="6" class="text-center text-muted">Không có Learner phù hợp.</td></tr>
    }
    else
    {
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.LearnerID</td>
                <td>@item.FirstName</td>
                <td>@item.LastName</td>
                <td>@item.Major?.MajorName</td>
                <td>@item.EnrollmentDate.ToString("dd/MM/yyyy")</td>
                <td class="text-nowrap">
                    <a asp-action="Edit" asp-route-id="@item.LearnerID">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@item.LearnerID" class="text-danger">Delete</a>
                </td>
            </tr>
        }
    }
    </tbody>
</table>
